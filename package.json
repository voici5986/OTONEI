{
  "name": "otonei",
  "version": "1.7.2",
  "private": true,
  "engines": {
    "node": ">=26 <27",
    "pnpm": ">=12 <13"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "bootstrap": "^5.3.8",
    "firebase": "^12.19.0",
    "localforage": "^1.10.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-icons": "^5.7.0",
    "react-toastify": "^11.1.0",
    "workbox-window": "^7.4.1"
  },
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "serve": "vite preview",
    "lint": "oxlint . --deny-warnings",
    "lint:css": "stylelint \"src/**/*.css\" --max-warnings=0",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --config=playwright.config.mjs",
    "test:e2e:pwa": "node scripts/run-pwa-e2e.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:toolchain": "node scripts/check-toolchain.mjs",
    "lint:ox": "oxlint .",
    "lint:ox:check": "oxlint . --deny-warnings",
    "format:ox": "oxfmt --write .",
    "format:ox:check": "oxfmt --check .",
    "verify:release": "pnpm run check:toolchain && pnpm run format:check && pnpm run lint && pnpm run lint:css && pnpm run typecheck && pnpm run test:coverage && pnpm run build && pnpm run test:e2e && pnpm run test:e2e:pwa && pnpm audit --prod",
    "prepare": "husky",
    "release": "semantic-release --no-ci"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx}": [
      "pnpm exec oxlint --fix",
      "pnpm exec oxfmt --write"
    ],
    "*.{json,jsonc,json5,css,scss,html,md,yaml,yml}": [
      "pnpm exec oxfmt --write"
    ],
    "*.css": [
      "pnpm exec stylelint"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@playwright/test": "^1.63.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "husky": "^9.1.7",
    "jsdom": "^30.1.0",
    "lint-staged": "^17.5.1",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "semantic-release": "^25.0.9",
    "stylelint": "^17.15.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-env-compatible": "^2.0.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1"
  }
}
